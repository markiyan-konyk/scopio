# This rig's wiring: cp .env.example .env, then docker compose up -d. Every variable: ../docs/CONFIGURATION.md
# No quotes, and no comment on the same line as a value (compose keeps it in the value).

# ---- Instrument addresses: leave empty to auto-discover by USB vendor id ----

# Rigol DG1022Z (galvo). Name it to pin one unit, or for Ethernet.
#GALVO_RESOURCE=USB0::0x1AB1::0x0642::DG1ZA000000000::INSTR

# Wavelength TC10 LAB. Leave EMPTY for USB: the transport follows kernel ownership. Name an Ethernet unit.
#TCLAB_RESOURCE=TCPIP::192.168.1.50::INSTR

# Sangaboard stage. A v0.5 HAT on the header must be named, and the UART set up (../INSTALL.md step 4).
#SANGABOARD_PORT=/dev/serial0

# ---- Camera (optional): the size reported before the sensor opens ----------
#CAM_W=640
#CAM_H=480
