# Visit absolute targets in order; the client sends the whole path, so network latency does not matter.
scopio_interfaces/StagePoint[] points
float32 settle_s          # pause at each point (e.g. to let beads settle / image)
---
# Result
bool success
int32 points_reached
---
# Feedback
int32 current_index
int32 x
int32 y
int32 z
