# Step the stage across a grid of stops over a rectangle; what each frame shows is the client's job.
int32 x_min           # stage steps
int32 x_max
int32 y_min
int32 y_max
int32 step            # steps between adjacent frames
float32 settle_s      # pause at each stop (let the stage settle / grab a frame)
---
# Result
bool success
int32 frames_visited
---
# Feedback
int32 frames_visited
int32 x
int32 y
