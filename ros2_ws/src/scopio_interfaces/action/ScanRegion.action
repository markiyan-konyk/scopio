# Jump-scan a rectangular region of the sample by stepping the stage across a
# grid of frames (no smooth motion needed -- it jumps frame to frame, knowing
# its global position). The backend only DRIVES the pattern and reports where it
# is; deciding what each frame contains is the client's job, from the video
# stream (the Pi does no image analysis).
int32 x_min           # stage steps
int32 x_max
int32 y_min
int32 y_max
int32 step            # steps between adjacent frames
float32 settle_s      # pause at each stop (let the stage settle / grab a frame)
---
# Result
bool success
int32 frames_visited
---
# Feedback
int32 frames_visited
int32 x
int32 y
