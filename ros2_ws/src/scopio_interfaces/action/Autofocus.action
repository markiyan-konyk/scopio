# Sweep Z, score sharpness at each point, park at the sharpest; every Z is approached from below (backlash).
int32 z_range        # half-range to sweep, in stage steps (e.g. 2000)
int32 steps          # number of sample points across the sweep (>=3, e.g. 15)
float32 settle_s     # pause after each Z move before measuring (e.g. 0.2)
---
# Result
bool success
int32 best_z         # absolute Z (steps) the stage ended at
float32 best_score   # focus score at best_z
string message
---
# Feedback
int32 index          # sample index just measured
int32 z              # absolute Z at this sample
float32 score        # focus score at this sample
