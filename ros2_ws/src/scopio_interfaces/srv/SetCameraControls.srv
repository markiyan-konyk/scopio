# Set any subset of the camera controls; NaN leaves a field unchanged.
float64 red_gain
float64 green_gain
float64 blue_gain
float64 colour_gain
float64 analogue_gain    # a brightness change: it survives the next frame-rate change
float64 contrast
float64 saturation
float64 brightness
float64 sharpness
