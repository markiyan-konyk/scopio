# Camera server as a systemd unit, the fallback to the camera container; install with install_systemd.sh (see README.md).
[Unit]
Description=SCOPIO Pi camera server (MJPEG + controls on loopback :8081)
After=network.target

[Service]
Type=simple
# install_systemd.sh substitutes the real repo path here.
ExecStart=/usr/bin/python3 __REPO__/camera_server/pi_camera_server.py
Environment=CAM_HOST=127.0.0.1
Environment=CAM_PORT=8081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
